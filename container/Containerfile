FROM docker.io/library/debian:12-slim

LABEL org.opencontainers.image.title="Asterisk VoIP"
LABEL org.opencontainers.image.description="Asterisk PBX for the Asterisk VoIP Platform"

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        asterisk \
        tini && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

COPY asterisk-config/extensions.conf /etc/asterisk/extensions.conf
COPY asterisk-config/pjsip.conf /etc/asterisk/pjsip.conf
COPY asterisk-config/rtp.conf /etc/asterisk/rtp.conf

RUN mkdir -p \
        /var/lib/asterisk \
        /var/log/asterisk \
        /var/spool/asterisk && \
    chown -R asterisk:asterisk \
        /etc/asterisk \
        /var/lib/asterisk \
        /var/log/asterisk \
        /var/spool/asterisk

USER asterisk

EXPOSE 5060/udp
EXPOSE 10000-10100/udp

ENTRYPOINT ["/usr/bin/tini", "--"]

CMD ["/usr/sbin/asterisk", "-f", "-U", "asterisk", "-G", "asterisk", "-vvv"]
